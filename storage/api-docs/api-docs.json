            "patch": {
                "tags": [
                    "Orders"
                ],
                "summary": "Update order status",
                "operationId": "2eeb8939f474c8aba6a9b7706dcf7845",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "pendente",
                                            "enviado",
                                            "entregue",
                                            "cancelado"
                                        ],
                                        "example": "enviado"
                                    },
                                    "payment_status": {
                                        "type": "string",
                                        "enum": [
                                            "aguardando",
                                            "aprovado",
                                            "recusado"
                                        ],
                                        "example": "aprovado"
                                    },
                                    "payment_method": {
                                        "type": "string",
                                        "enum": [
                                            "pix",
                                            "cartao_credito",
                                            "boleto"
                                        ],
                                        "example": "pix"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success"
                    },
                    "422": {
                        "description": "Business rule violation"
                    },
                    "404": {
                        "description": "Not found"
                    }
