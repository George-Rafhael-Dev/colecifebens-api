                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "price",
                                    "condition",
                                    "stock",
                                    "user_id",
                                    "category_id"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Goku Super Sayajin"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Action figure raro"
                                    },
                                    "price": {
                                        "type": "number",
                                        "example": 350
                                    },
                                    "rarity": {
                                        "type": "string",
                                        "example": "raro"
                                    },
                                    "condition": {
                                        "type": "string",
                                        "enum": [
                                            "novo",
                                            "usado",
                                            "restaurado"
                                        ],
                                        "example": "novo"
                                    },
                                    "stock": {
                                        "type": "integer",
                                        "example": 3
                                    },
                                    "user_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "category_id": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
